generator client {
  provider = "prisma-client-js"
}

// The active provider is selected by DATABASE_URL (see lib/prisma.ts and
// prisma.config.ts). This line is the one place Prisma needs a static value:
// run `npm run db:use` after changing DATABASE_URL to rewrite it and regenerate
// the client. Default: sqlite.
datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  apiKeys      ApiKey[]
  projects     Project[]
}

model Project {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  issueCounter    Int            @default(0)
  createdByUserId String
  createdBy       User           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  apiKeys         ApiKey[]
  issues          Issue[]
  documents       Document[]
  diffs           Diff[]
  skills          Skill[]
  projectContext  ProjectContext?
}

model ApiKey {
  id        String    @id @default(cuid())
  label     String
  keyHash   String    @unique
  last4     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Issue {
  id              String            @id @default(cuid())
  key             String
  title           String
  description     String            @default("")
  column          String            @default("BACKLOG")
  agentAssignee   String?
  agentAssignTs   DateTime?
  doneAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependencies    IssueDependency[]    @relation("IssueDependencies")
  blockers        IssueDependency[]    @relation("IssueBlockers")
  documentLinks   DocumentIssueLink[]
  diffs           Diff[]

  @@unique([projectId, key])
}

model IssueDependency {
  dependentId String
  dependsOnId String
  dependent   Issue  @relation("IssueDependencies", fields: [dependentId], references: [id], onDelete: Cascade)
  dependsOn   Issue  @relation("IssueBlockers", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([dependentId, dependsOnId])
}

model Comment {
  id             String   @id @default(cuid())
  targetType     String
  targetId       String
  body           String
  authorUserId   String?
  authorLabel    String
  status         String   @default("open")
  createdAt      DateTime @default(now())
  anchorStart    Int?
  anchorEnd      Int?
  anchorFilePath String?
}

model Document {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versions   DocumentVersion[]
  issueLinks DocumentIssueLink[]
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String
  authorUserId  String?
  authorLabel   String
  createdAt     DateTime @default(now())

  @@unique([documentId, versionNumber])
}

model DocumentIssueLink {
  documentId String
  issueId    String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([documentId, issueId])
}

model Diff {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  branch       String
  diffText     String
  issueId      String
  authorUserId String?
  authorLabel  String
  createdAt    DateTime @default(now())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  prompt      String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files       SkillFile[]

  @@unique([projectId, name])
}

model SkillFile {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  name      String
  content   String
  createdAt DateTime @default(now())

  @@unique([skillId, name])
}

model ProjectContext {
  id           String   @id @default(cuid())
  content      String   @default("")
  authorLabel  String   @default("system")
  authorUserId String?
  updatedAt    DateTime @updatedAt
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
}
