generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  apiKeys      ApiKey[]
}

model ApiKey {
  id        String    @id @default(cuid())
  label     String
  keyHash   String    @unique
  last4     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  column      String   @default("BACKLOG")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id           String   @id @default(cuid())
  targetType   String   // 'issue' | 'document_section' | 'diff_line'
  targetId     String
  body         String
  authorUserId String?
  authorLabel  String
  status       String   @default("open")
  createdAt    DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions   DocumentVersion[]
  issueLinks DocumentIssueLink[]
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String
  authorUserId  String?
  authorLabel   String
  createdAt     DateTime @default(now())

  @@unique([documentId, versionNumber])
}

model DocumentIssueLink {
  documentId String
  issueId    String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, issueId])
}
