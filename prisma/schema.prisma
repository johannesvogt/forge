generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  apiKeys      ApiKey[]
}

model ApiKey {
  id        String    @id @default(cuid())
  label     String
  keyHash   String    @unique
  last4     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  column      String   @default("BACKLOG")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id            String   @id @default(cuid())
  targetType    String   // 'issue' | 'document_section' | 'diff_line'
  targetId      String
  body          String
  authorUserId  String?
  authorLabel   String
  status        String   @default("open")
  createdAt     DateTime @default(now())
  anchorStart    Int?
  anchorEnd      Int?
  anchorFilePath String?
}

model Document {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions   DocumentVersion[]
  issueLinks DocumentIssueLink[]
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String
  authorUserId  String?
  authorLabel   String
  createdAt     DateTime @default(now())

  @@unique([documentId, versionNumber])
}

model DocumentIssueLink {
  documentId String
  issueId    String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, issueId])
}

model Diff {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  branch       String
  diffText     String
  issueId      String
  authorUserId String?
  authorLabel  String
  createdAt    DateTime @default(now())
}

model Skill {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  prompt      String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  files       SkillFile[]
}

model SkillFile {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  name      String
  content   String
  createdAt DateTime @default(now())

  @@unique([skillId, name])
}

model ProjectContext {
  id           String   @id @default("singleton")
  content      String   @default("")
  authorLabel  String   @default("system")
  authorUserId String?
  updatedAt    DateTime @updatedAt
}
