# SQLite by default — no database server needed.
DATABASE_URL="file:./prisma/dev.db"
# For Postgres instead, use the docker-compose database and run `npm run db:use`:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/forge"
# Needed on ARM64 machines (Apple Silicon, etc.) where native SWC binaries don't run
NEXT_TEST_WASM_DIR="./node_modules/@next/swc-wasm-nodejs"
